JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_KEY=replace-with-a-random-internal-key
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=iBanking TDTU <your-account@gmail.com>

# Gmail đã xác thực là địa chỉ gửi; người nhận vẫn là email sinh viên TDTU.
# SMTP_USER và địa chỉ bên trong MAIL_FROM phải giống nhau.
# SMTP_PASSWORD là App Password của tài khoản Gmail (không phải mật khẩu thường).
